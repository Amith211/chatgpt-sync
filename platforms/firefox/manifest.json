{
  "manifest_version": 3,
  "name": "ChatGPT Sync",
  "version": "0.3.18",
  "description": "Detects and prevents ChatGPT conversation synchronisation issues.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-sync@amith.co.uk",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  }
}
